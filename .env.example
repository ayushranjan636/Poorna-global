# ---------------------------------------------------------------------------
# Contact / enquiry pipeline — TEMPLATE
#
# This file is COMMITTED to the repository. It must contain placeholders only,
# never real credentials.
#
# To configure a machine:
#   cp .env.example .env.local      and fill in the real values there
#
# `.env.local` is covered by .gitignore. For production, set the same keys as
# Environment Variables in the Vercel project — values here are not deployed.
# ---------------------------------------------------------------------------

# --- Where enquiries are delivered -----------------------------------------
ENQUIRY_TO=raghunandan.ar@poornaglobalstrategies.com
ENQUIRY_BCC=ayush@poornaglobalstrategies.com

# --- SMTP ------------------------------------------------------------------
# Gmail / Google Workspace: generate an App Password at
# https://myaccount.google.com/apppasswords — the normal account password
# will not work once 2FA is on. Paste it without spaces.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# --- Google Sheets (optional) ----------------------------------------------
# Enquiries are appended as rows by the Apps Script web app in
# scripts/enquiry-apps-script.gs. Setup, in that file's header comment:
#   1. paste the script into the sheet's Apps Script editor
#   2. Project Settings → Script Properties → add SHEET_WEBHOOK_SECRET
#   3. Deploy → New deployment → Web app, access "Anyone"
#
# SHEET_WEBHOOK_SECRET below must match that script property exactly.
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_SECRET=

# --- Frontend --------------------------------------------------------------
# The form posts to /api/enquiry by default; only set this to point somewhere
# else. VITE_CONTACT_EMAIL is the fallback shown if a submission fails.
# VITE_CONTACT_ENDPOINT=
VITE_CONTACT_EMAIL=raghunandan.ar@poornaglobalstrategies.com
